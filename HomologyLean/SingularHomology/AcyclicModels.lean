noncomputable def functorEquivalence' (n : ℕ) :
  Functor.uncurry.obj (HomologicalComplex.complexOfFunctorsToFunctorToComplex (T := C) (V := ModuleCat.{w} R) (c := ComplexShape.down ℕ)) ⋙
    (HomologicalComplex.shortComplexFunctor (ModuleCat R) (ComplexShape.down ℕ) n) ≅
    Functor.uncurry.obj
      (HomologicalComplex.shortComplexFunctor
          (C ⥤ ModuleCat.{w} R) (ComplexShape.down ℕ) n ⋙
        (ShortComplex.functorEquivalence
          C (ModuleCat.{w} R)).functor)
     := by sorry

noncomputable def functorEquivalence (F : FunctorComplex (C := C) (R := R)) (n : ℕ) :
  (HomologicalComplex.complexOfFunctorsToFunctorToComplex.obj ) F ⋙
    (HomologicalComplex.shortComplexFunctor (_) (ComplexShape.down ℕ) n) ≅
    (((ShortComplex.functorEquivalence _ _).functor).obj ( (HomologicalComplex.shortComplexFunctor (_) (ComplexShape.down ℕ) n).obj F))

     := by
  exact ((Functor.curry).mapIso (functorEquivalence' n)).app F
/-! ## 1. The concrete basis-and-models formulation -/

section BasisVersion

variable {C : Type u} [Category.{w} C]
variable {R : Type w} [CommRing R]




abbrev FreeModule : Type w ⥤ ModuleCat R := (forget (ModuleCat R)).leftAdjoint



structure ModelObjects where
  Index : Type w
  model : Index → C


variable (P : ObjectProperty C) [HasCoproductsOfShape P.FullSubcategory (C ⥤ ModuleCat.{w} R)]



/--
`F` is freely generated by elements situated on chosen model objects.

For each `X`, the basis vectors of `F.obj X` are indexed by pairs consisting
of a model and a morphism from that model to `X`.
-/
-- structure ModelFree (M : ModelObjects) (F : C ⥤ ModuleCat R) where
--   basisElement : ∀ i, F.obj (M.model i)
--   basis : ∀ X, Module.Basis (Σ i, M.model i ⟶ X) R (F.obj X)
--   basis_apply : ∀ X i (f : M.model i ⟶ X),
--     basis X ⟨i, f⟩ = F.map f (basisElement i)


abbrev ModelFreeFunctor (M : ModelObjects (C := C)) : C ⥤ ModuleCat R :=
  ∐ fun i : M.Index => Hom[M.model i |-] ⋙ FreeModule



abbrev ModelFreeFunctor' : C ⥤ ModuleCat R :=
  ∐ fun i : P.FullSubcategory => Hom[ i.obj |-] ⋙ FreeModule

structure ModelFree (M : ModelObjects) (F : C ⥤ ModuleCat R) where
  iso : F ≅ ModelFreeFunctor M

structure ModelFree' (F : C ⥤ ModuleCat R) where
  iso : F ≅ ModelFreeFunctor' P

/-- A choice of a model basis in every chain degree. -/
abbrev ComplexModelFree (M : ModelObjects) (F : FunctorComplex (C := C) (R := R)) :=
  ∀ n, ModelFree M (F.X n)


structure ShortComplexModelFree  (F : ShortComplex (C ⥤ ModuleCat R)) where
  free₁ := ModelFree' P F.1
  free₂ := ModelFree' P F.2
  free₃ := ModelFree' P F.3



-- set_option trace.Meta.synthInstance true

/--
The target is acyclic on precisely the model objects needed by the two
inductive arguments.  This reproduces the hypotheses in the Lean 3 file.
-/
def AcyclicOnModels
    (M : ModelObjects (C := C))
    (G : FunctorComplex (C := C) (R := R)) : Prop :=
   ∀ i, ∀ n, 0 < n →
    ((G.asFunctor ⋙ (HomologicalComplex.shortComplexFunctor (_) (ComplexShape.down ℕ) n)).obj
      (M.model i)).Exact
    -- (G.asFunctor.obj (M.model i)).ExactAt n



-- variable (P) in
noncomputable def ShortComplexAcyclicOnModels (F : ShortComplex (C ⥤ ModuleCat R)) :=
  (F.map ((whiskeringLeft P.FullSubcategory C (ModuleCat.{w} R)).obj P.ι)).Exact




def EpiOnModels {F G : (C ⥤ ModuleCat R)}
  (α : F ⟶ G)
  (M : ModelObjects (C := C)) : Prop :=
  ∀ i, Epi (α.app (M.model i))


def EpiOnModels' {F G : (C ⥤ ModuleCat R)}
  (α : F ⟶ G) : Prop :=
  ∀ i, Epi (α.app (P.ι.obj i))


