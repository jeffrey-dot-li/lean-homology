{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "lean-lsp": {
      "type": "local",
      "command": ["bash", "-c", "exec \"$PWD/scripts/start-lean-mcp.sh\""],
      "cwd": ".",
      "enabled": true,
      "timeout": 60000
    },
    "citra": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "export PATH=\"$PWD/.devenv/profile/bin:$PATH\"; exec npx -y @sylphx/citra"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 60000
    }
  }
}
